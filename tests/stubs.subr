# Stubs for the installer tests (sourced by each *_test body): a work
# directory with
#   bin/      bsddialog, chroot, sysctl, find, diskinfo, dmesg and the ZFS
#             importer, first in PATH
#   root/     the "installed system" BSDINSTALL_CHROOT points at; chroot
#             runs root/<program> on the host, so the programs the
#             installer starts there are fake scripts too
#   stub/     answers for bsddialog and the logs of every stub
# Nothing here touches a disk, a configuration or the host's dialogs.
#
# bsddialog answers: stub/answers holds one line per input dialog
# (--inputbox, --passwordbox, --yesno, --menu) in order, "<exit status>|<text>":
# "0|fw1" types fw1 and presses OK, "1|" presses Cancel. When the lines run
# out every further input dialog is cancelled, so a script that loops
# forever on bad input ends. Message boxes need no line. Every call is
# logged to stub/bsddialog.log as one line, "|"-separated arguments.

SRC=
STUB=

stub_setup()
{
	SRC=$(cd "$(atf_get_srcdir)/../src" && pwd)
	WORK=$(pwd)
	STUB=${WORK}/stub
	mkdir -p ${WORK}/bin ${WORK}/root ${STUB}
	: > ${STUB}/answers
	: > ${STUB}/bsddialog.log
	export STUB
	export BSDINSTALL_CHROOT=${WORK}/root
	export PATH=${WORK}/bin:${PATH}

	cat > ${WORK}/bin/bsddialog <<'EOF'
#!/bin/sh
{ printf 'CALL'; for A in "$@"; do printf '|%s' "${A}"; done; echo; } >> ${STUB}/bsddialog.log
for A in "$@"; do
	case "${A}" in
	--inputbox|--passwordbox|--yesno|--menu)
		N=$(($(cat ${STUB}/answers.n 2> /dev/null || echo 0) + 1))
		echo ${N} > ${STUB}/answers.n
		LINE=$(sed -n "${N}p" ${STUB}/answers)
		[ -n "${LINE}" ] || exit 1
		printf '%s' "${LINE#*|}" >&2
		exit ${LINE%%|*}
		;;
	esac
done
exit 0
EOF
	cat > ${WORK}/bin/chroot <<'EOF'
#!/bin/sh
# chroot <dir> <program> [args]: run <dir><program> on the host
echo "$*" >> ${STUB}/chroot.log
ROOT=${1}
PROGRAM=${2}
shift 2
[ -x "${ROOT}${PROGRAM}" ] || { echo "chroot stub: no ${ROOT}${PROGRAM}" >&2; exit 127; }
exec "${ROOT}${PROGRAM}" "$@"
EOF
	cat > ${WORK}/bin/sysctl <<'EOF'
#!/bin/sh
[ "$*" = "-n hw.realmem" ] || { echo "sysctl stub: $*" >&2; exit 1; }
echo ${FAKE_REALMEM}
EOF
	chmod +x ${WORK}/bin/*
}

# answer <line> ...: queue bsddialog answers
answer()
{
	for LINE in "$@"; do
		printf '%s\n' "${LINE}" >> ${STUB}/answers
	done
}

# fake_program <path in root> <body>: a fake program of the installed system
fake_program()
{
	mkdir -p "$(dirname "${BSDINSTALL_CHROOT}${1}")"
	printf '#!/bin/sh\n%s\n' "${2}" > "${BSDINSTALL_CHROOT}${1}"
	chmod +x "${BSDINSTALL_CHROOT}${1}"
}

# dialogs <option>: the bsddialog calls with that option (e.g. --msgbox)
dialogs()
{
	grep -F "|${1}|" ${STUB}/bsddialog.log
}

# run_script <name> [args]: run src/<name>.sh as bsdinstall does
run_script()
{
	_SCRIPT=${1}
	shift
	sh ${SRC}/${_SCRIPT}.sh "$@" > ${WORK}/script.out 2> ${WORK}/script.err
}
